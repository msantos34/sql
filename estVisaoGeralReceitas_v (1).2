--		, initcap(polo.nam_sub_regional)																	as coordenador_polo
--		, initcap(polo.nam_district)																		as gerente_comercial
--		, initcap(polo.nam_manager)																			as gerente_geral_polo
--		, case 
--			when des_origin ilike '%segmenta%' 																then 'SEGMENTACAO'
--			when des_origin ilike '%gerenciado%' 															then 'GERENCIADO'
--			else 'NOVO'
--			end 																							as des_origin
--        , case 
--			when lower (nam_polo) like '% lt%' 																then 'LT' 
--     		when lower (nam_polo) like '% virtual%' 														then 'VIRTUAL'
--     		when lower (nam_polo) like '% sr%' 																then 'SENIOR'
--			else 'PLENO' 
--			end 																							as classif_polo
--		, upper(polo.nam_polo)																				as nam
--		, case
--			when nam = 'BOLSÃO POLOS'
--				or nam is null 																				then null
--			else substring(nam, 1, 2)															
--			end 																							as uf
--		, trim(replace(replace(substring(nam, 3, 100), ' LT', ''), 'VIRTUAL', ''))							as nam_polo
