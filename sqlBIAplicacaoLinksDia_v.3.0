

/*

	APLICACOES LINK POLO 2.0.0

	Derivacao das tabelas

		DAUX	- Tabelas Auxiliares
		DD		- Tabelas Dimensao
		DF		- Tabelas Fato

2.0.0
19-08-2026
		- Refatoracao consulta para melhoria de performance e correcao da fonte de hierarquia foto
		  dos executivos
 
		Foi identificado que na tabela da hierarquia foto, quando um executivo e desligado, o mes em
		que ele foi desligado a produtividade dele nao e capturada pois na tabela
		<tbl_vl_extc_polo_fechamento> a linha do mes que ele saiu fica com TBA, ou seja, sendo
		impossivel capturar seu login para cruzar com a tabela de aplicacao de links.

		O mesmo deve ocorrer para executivos que assumiram um TBA. No mes em curso a produtividade
		fica no limbo uma vez que a linha de hierarquia do cliente fica atrelada ao TBA.

		- Havia clientes cujo a entrada na base do Polo eram posteriores ao periodo que uma negociacao
		foi realizada. Sendo assim, isso foi corrigido no processo para considerar a aplicacao do
		cliente polo apenas no mes em que ele de fato era do polo.


*/



--////>>>>>>>>>>>>>>> PROCESSO DDHIERARQUIA
drop table if exists planejamentocomercial_sandbox.planejamentocomercial_work.DDFILME;
create table planejamentocomercial_sandbox.planejamentocomercial_work.DDFILME
distkey(idt_safepay_user)
sortkey(idt_safepay_user, dt_reference)
as	
	--//// DDHIERARQUIA FILME
	select
		  date_trunc( 'month', current_date-1 )::date											as dt_reference  --> existem casos onde o cliente aparece em mais de um mes. Como a tabela contempla dados filme deixei o current_date para considerar apenas o mes atual
		, idt_safepay_user
		, cod_cart::bigint
		, initcap(nam_executive)																as executivo
		, lower(nam_current_executive)															as login
		, cod_matricula_exe::bigint
		, date_trunc('month', peop.data_de_entrada)::date										as month_in
		, date_trunc('month', peop.data_de_desligamento)::date									as month_out
		, 'FILME'::varchar(10)																	as origem
	from
		dax_share_dax.tbl_vl_extc_polo filme
	left join 
		dax_share_dax_tools.vw_people_status peop
		on peop.codigo_empregado = filme.cod_matricula_exe
	where polo_empresas in (0, 2, 3)
--		and dat_start::date >= '2025-01-01' -- filtro usado nos relatorios de safra do time de polos
	group by all
	;



drop table if exists planejamentocomercial_sandbox.planejamentocomercial_work.DDFOTO;
create table planejamentocomercial_sandbox.planejamentocomercial_work.DDFOTO
distkey(idt_safepay_user)
sortkey(idt_safepay_user, dt_reference)
as
	--//// DDHIERARQUIA FOTO
	select
		  date_trunc( 'month', ft.data_fechamento )::date										as dt_reference
		, ft.idt_safepay_user
		, ft.cod_cart::bigint
		, initcap(ft.nam_executive)																as executivo
		, lower(ft.nam_current_executive)														as login
		, ft.cod_matricula_exe::bigint
		, date_trunc('month', peop.data_de_entrada)::date										as month_in
		, date_trunc('month', peop.data_de_desligamento)::date									as month_out
		, 'FOTO'::varchar(10)																	as origem
	from
		dax_share_dax.tbl_vl_extc_polo_fechamento ft
--	join
--		planejamentocomercial_sandbox.planejamentocomercial_work.DDFILME
--		using( idt_safepay_user ) --> garante que serão considerados apenas clientes cujo a dat_start é posterior a '2025-01-01' conforme regra usada nos relatórios de Polo.
	left join 
		dax_share_dax_tools.vw_people_status peop
		on peop.codigo_empregado = ft.cod_matricula_exe
	where 1=1
		and ft.data_fechamento >= '2025-01-01'
	group by all
	;



drop table if exists planejamentocomercial_sandbox.planejamentocomercial_work.DDHIERARQUIA;
create table planejamentocomercial_sandbox.planejamentocomercial_work.DDHIERARQUIA
distkey(idt_safepay_user)
sortkey(idt_safepay_user, dt_reference)
as
	select
		  dt_reference
		, idt_safepay_user
		, cod_cart
		, executivo
		, login
		, cod_matricula_exe
		, month_in
		, month_out
		, origem
	from
		planejamentocomercial_sandbox.planejamentocomercial_work.DDFOTO
	union all
	select
		  dt_reference
		, idt_safepay_user
		, cod_cart
		, executivo
		, login
		, cod_matricula_exe
		, month_in
		, month_out
		, origem
	from
		planejamentocomercial_sandbox.planejamentocomercial_work.DDFILME
	;


--////>>>>>>>>>>>>>>> PROCESSO TRATA OS CASOS DE TBA
--//// ATRIBUI OS DADOS DA LINHA DO EXECUTIVO DE SAIDA PARA A LINHA DO TBA, SE <dt_reference> DO TBA = <month_out> DO EXECUTIVO DA LINHA ANTERIOR, CAPTURA OS DADOS DO EXECUTIVO QUE SAIU NO DECORRER DO MÊS
--//// E OS DADOS DO EXECUTIVO QUE ENTROU, SE <dt_reference> DO TBA = <month_in> DO EXECUTIVO DA LINHA SEGUINTE CAPTURA OS DADOS DA LINHA DO EXECUTIVO DE ENTADA
drop table if exists planejamentocomercial_sandbox.planejamentocomercial_work.DDHIER_TREATED;
create table planejamentocomercial_sandbox.planejamentocomercial_work.DDHIER_TREATED
distkey(idt_safepay_user)
sortkey(idt_safepay_user, dt_reference)
as
with
	DIMHIER as (
		select
			  dt_reference
			, idt_safepay_user
			, coalesce(cod_cart, -1)															as cod_cart --> tratado para que os processos abaixo nao deixem de funcionar
			, executivo
			, login
			, cod_matricula_exe
			, month_in
			, month_out
			, case 
				when upper(executivo) like '%TBA%' then 1 else 0 
				end 																			as flg_tba
		from
			planejamentocomercial_sandbox.planejamentocomercial_work.DDHIERARQUIA
		group by all
	)
	, REDIR as (
		select
			  idt_safepay_user
			, cod_cart
			, dt_reference
			, flg_tba
			, case
				--//// TBA de SAIDA: o mes virou TBA porque o executivo da linha anterior foi desligado neste mes
				when flg_tba = 1
					 and lag(flg_tba) over (partition by idt_safepay_user, cod_cart 
					 							order by dt_reference) = 0
							 and lag(month_out)	over (partition by idt_safepay_user, cod_cart 
							 							order by dt_reference) = dt_reference
				then lag(dt_reference) over (partition by idt_safepay_user, cod_cart 
												order by dt_reference)
				--//// TBA de ENTRADA: o mes esta TBA porque o executivo da linha seguinte entrou neste mes
				when flg_tba = 1
					 and lead(flg_tba) over (partition by idt_safepay_user, cod_cart
					 							order by dt_reference) = 0
						 and lead(month_in) over (partition by idt_safepay_user, cod_cart
						 							order by dt_reference) = dt_reference
				then lead(dt_reference) over (partition by idt_safepay_user, cod_cart
												order by dt_reference)
				else dt_reference
			  end																				as src_dt
		from
			DIMHIER
	)
	select
		  r.dt_reference
		, r.src_dt
		, h.idt_safepay_user
		, h.cod_cart
		, h.executivo
		, h.login
		, h.cod_matricula_exe
		, h.month_in
		, h.month_out
		, h.flg_tba
	from
		REDIR r
	join
		DIMHIER h
		on  h.idt_safepay_user	= r.idt_safepay_user
		and h.cod_cart			= r.cod_cart
		and h.dt_reference		= r.src_dt
	group by all
	qualify 
		row_number() over (partition by r.dt_reference, h.cod_cart, h.idt_safepay_user
								order by h.flg_tba) = 1 --> exclui duplicidades de linhas que foram tratadas do TBA. Não retorna 1 cliente com um TBA e um executivo no mesmo mês.
--	order by dt_reference
	;



--//// CLASSIFICACAO DO CREDENCIAMENTO
--////////////////////////////////////////////////////////////////////////////////////////////////////
--// REGRA POLO
--//	INCREMENTO  → teve TPV no mês imediatamente anterior ao dat_start (credenciamento)
--//	NOVO        → nunca transacionou antes do mes de credenciamento
--//	REATIVAÇÃO  → demais casos ( ja transacionou antes , mas nao necessariamente no mes anterior )
--////////////////////////////////////////////////////////////////////////////////////////////////////
--//// CREDENCIAMENTOS DO POLO
drop table if exists planejamentocomercial_sandbox.planejamentocomercial_work.DDCREDENCIAMENTO;
create table planejamentocomercial_sandbox.planejamentocomercial_work.DDCREDENCIAMENTO
distkey(idt_safepay_user)
sortkey(idt_safepay_user, dat_start)
as
	select
		  idt_safepay_user
		, dat_start::date																		as dat_start
		, last_day(dat_start::date)																as month_credenciamento
		, sum(case when last_day(dat_start::date) = dat_reference_values then num_tpv_value else 0 end) as num_tpv
		, cast(0 as decimal(10,2)) 																as tpv_m_menos_1
		, cast(null as date) 																	as first_tpv_date
		, null::varchar(100)																	as tipo_credenciamento
		, legado_novo
	from
		dax_share_dax.tbl_vl_extc_polo
	where 
		polo_empresas in (0, 2, 3)
		and dat_start::date >= '2025-01-01' --> filtro usado nos relatorios de safra e matriz do time de polos. mantive para que os numeros estejam em conformidade com o deles, ainda que existam clientes com marcações anterirores a essa e com negociações nos últimos 13 meses.
	group by all
	;



--//// HISTORICO MENSAL TPV
drop table if exists planejamentocomercial_sandbox.planejamentocomercial_work.TPV;
create table planejamentocomercial_sandbox.planejamentocomercial_work.TPV
distkey(idt_safepay_user)
sortkey(idt_safepay_user, dat_reference)
as
	select 
		  marg.idt_safepay_creditor																	as idt_safepay_user
		, last_day( marg.dat_reference ) 															as dat_reference
		, sum( marg.num_tpv_value ) 																as num_tpv
	from 
		dax_share_dax.ent_margin_summary marg
	where exists(
			select 1
			from
				planejamentocomercial_sandbox.planejamentocomercial_work.DDCREDENCIAMENTO cli
			where marg.idt_safepay_creditor = cli.idt_safepay_user
			)
	group by 1, 2
	;



--//// Primeiro mês com TPV da vida do cliente
drop table if exists planejamentocomercial_sandbox.planejamentocomercial_work.TPV_FIRST;
create table planejamentocomercial_sandbox.planejamentocomercial_work.TPV_FIRST
distkey(idt_safepay_user)
sortkey(idt_safepay_user, first_tpv_date)
as
		select
		      idt_safepay_user
		    , min(dat_reference) 																	as first_tpv_date
		from 
			planejamentocomercial_sandbox.planejamentocomercial_work.TPV
		where 
			num_tpv > 0
		group by 1
	;



--//// Marcando a primeira transação
update 
	planejamentocomercial_sandbox.planejamentocomercial_work.DDCREDENCIAMENTO 
set 
	first_tpv_date = xx.first_tpv_date
from 
	planejamentocomercial_sandbox.planejamentocomercial_work.DDCREDENCIAMENTO t1 
inner join 
	planejamentocomercial_sandbox.planejamentocomercial_work.TPV_FIRST xx 
	on xx.idt_safepay_user = t1.idt_safepay_user
;



--//// Marca se teve TPV no mês anterior ao credenciamento
	update 
		planejamentocomercial_sandbox.planejamentocomercial_work.DDCREDENCIAMENTO 
	set 
		tpv_m_menos_1 = xx.num_tpv
	from 
		planejamentocomercial_sandbox.planejamentocomercial_work.DDCREDENCIAMENTO t1
	inner join 
		planejamentocomercial_sandbox.planejamentocomercial_work.TPV xx 
		on xx.idt_safepay_user = t1.idt_safepay_user 
		and xx.dat_reference = last_day(dateadd(month, -1, t1.dat_start))
	;



--//// INCREMENTO
	update 
		planejamentocomercial_sandbox.planejamentocomercial_work.DDCREDENCIAMENTO
	set 
		tipo_credenciamento = 'INCREMENTO'
	from 
		planejamentocomercial_sandbox.planejamentocomercial_work.DDCREDENCIAMENTO t1
	inner join 
		planejamentocomercial_sandbox.planejamentocomercial_work.TPV t 
		on t.idt_safepay_user = t1.idt_safepay_user 						/* ids iguais entre bases */
		and t.dat_reference = last_day(dateadd(month, -1, t1.dat_start)) 	/* a data do tpv é igual ao mês anterior ao credenciamento */
		and t.num_tpv > 0 													/* o tpv do mês anterior é maior que zero */
	where 
		t1.num_tpv > 0
	;



--//// NOVO
--//// Credenciado no mês atual
--//// e primeiro TPV no mês do credenciamento ou nunca transacionou
	update 
		planejamentocomercial_sandbox.planejamentocomercial_work.DDCREDENCIAMENTO
	set 
		tipo_credenciamento = 'NOVO'
	where 
		tipo_credenciamento is null
		  and not exists (
			  select 1
			  from planejamentocomercial_sandbox.planejamentocomercial_work.TPV
			  where planejamentocomercial_sandbox.planejamentocomercial_work.TPV.idt_safepay_user = planejamentocomercial_sandbox.planejamentocomercial_work.DDCREDENCIAMENTO.idt_safepay_user
				and planejamentocomercial_sandbox.planejamentocomercial_work.TPV.dat_reference < planejamentocomercial_sandbox.planejamentocomercial_work.DDCREDENCIAMENTO.month_credenciamento
		  )
	;



--////CLIENTES QUE AINDA NÃO TRANSACIONARAM SÃO MARCADOS COMO NOVO
	update 
		planejamentocomercial_sandbox.planejamentocomercial_work.DDCREDENCIAMENTO 
	set 
		tipo_credenciamento = 'NOVO' 
	where 
		tipo_credenciamento is null 
		and num_tpv = 0 
		and first_tpv_date is null
	; 
 


--//// REATIVAÇÃO
	update 
		planejamentocomercial_sandbox.planejamentocomercial_work.DDCREDENCIAMENTO
	set 
		tipo_credenciamento = 'REATIVAÇÃO'
	where 
		tipo_credenciamento is null
	;



--//// MARCACAO NOVA REGRA - CLIENTES COM ATINGIMENTO 6K
	update 
		planejamentocomercial_sandbox.planejamentocomercial_work.DDCREDENCIAMENTO 
	set 
		tipo_credenciamento = 'NOVO - 6K'
	from 
		planejamentocomercial_sandbox.planejamentocomercial_work.DDCREDENCIAMENTO t1 
	where 1=1
		and t1.legado_novo = 'M0' --> confirmado com o Wesley, clientes com essa marcacao ja tem o atingimento de 6k no TPV a partir de set/2026
		and t1.tipo_credenciamento = 'NOVO'
		and t1.month_credenciamento >= '2026-09-01'
	;



--//// TABELA CREDENCIAMENTO AJUSTADA
drop table if exists planejamentocomercial_sandbox.planejamentocomercial_work.DDCREDENCIAMENTO_tmp;
create table planejamentocomercial_sandbox.planejamentocomercial_work.DDCREDENCIAMENTO_tmp
distkey(idt_safepay_user)
sortkey(idt_safepay_user, dat_start)
as
	select
		  a.idt_safepay_user
		, a.dat_start
		, a.month_credenciamento
		, sum( a.num_tpv )										as num_tpv
		, max( a.tpv_m_menos_1 )								as tpv_m_menos_1
		, min( a.first_tpv_date )								as first_tpv_date
		, max( a.tipo_credenciamento )							as tipo_credenciamento
	from
		planejamentocomercial_sandbox.planejamentocomercial_work.DDCREDENCIAMENTO a
	group by all
	;


drop table planejamentocomercial_sandbox.planejamentocomercial_work.DDCREDENCIAMENTO;
	alter table planejamentocomercial_sandbox.planejamentocomercial_work.DDCREDENCIAMENTO_tmp
	rename to DDCREDENCIAMENTO
	;



--////>>>>>>>>>>>>>>> DIMENSOES DE ELEGIBILIDADE
--//PROCESSO ATUA APENAS PARA OTIMIZAR O FILTRO REALIZADO NA BASE DE LINKS 
--//// DDEXEC_MES - LOGINS ELEGIVEIS POR MES
drop table if exists planejamentocomercial_sandbox.planejamentocomercial_work.DDEXEC_MES;
create table planejamentocomercial_sandbox.planejamentocomercial_work.DDEXEC_MES
diststyle all
sortkey(dt_reference, login)
as
	select
		  dt_reference
		, login
	from
		planejamentocomercial_sandbox.planejamentocomercial_work.DDHIER_TREATED
	where
		login is not null
	group by all
	;



--//// DDCLI_MES - CLIENTES ELEGIVEIS POR MES
drop table if exists planejamentocomercial_sandbox.planejamentocomercial_work.DDCLI_MES;
create table planejamentocomercial_sandbox.planejamentocomercial_work.DDCLI_MES
distkey(idt_safepay_user)
sortkey(idt_safepay_user, dt_reference)
as
	select
		  dt_reference
		, idt_safepay_user
	from
		planejamentocomercial_sandbox.planejamentocomercial_work.DDHIER_TREATED
	group by all
	;


--////>>>>>>>>>>>>>>> PROCESSO CAPTURA E TRATAMENTO BASE DE LINKS APLICADOS
--//DFPROMOTION_RAW - Devido a atribuicao do link a quem alterou e a quem gerou, foi
--//				  necessario realizarmos um tratamento para garantir que seja considerado
--//				  o executivo correto.
--//
--//				  A tabela e um log: quando um agent negocia um link com o cliente, e gerada
--//				  uma linha de remocao de um link e uma linha de atribuicao. Como esses eventos
--//				  podem ocorrer em periodos diferentes, o lag particiona apenas por cliente,
--//				  para enxergar toda a linha do tempo dele.
--////////////////////////////////////////////////////////////////////////////////////////////////////////
drop table if exists planejamentocomercial_sandbox.planejamentocomercial_work.DFPROMOTION_RAW;
create table planejamentocomercial_sandbox.planejamentocomercial_work.DFPROMOTION_RAW
distkey(idt_safepay_user)
sortkey(idt_safepay_user, dat_start, dat_end)
as
	select
		  prom.idt_safepay_user
		, date_trunc('month', prom.dat_start)::date												as month_reference
		, prom.dat_start
		, prom.dat_end
		, prom.dat_load
		, lower(replace(upper(prom.nam_change_agent), 'FDV_', ''))								as login
		, prom.idt_mobi_promotion
		, lower(nam_pro.nam_promotion)															as nam_promotion
		, coalesce(  
					lag(lower(replace(upper(prom.nam_change_agent), 'FDV_', '')))
						over (partition by prom.idt_safepay_user 
								order by prom.dat_start, prom.dat_end)
					, login 
				)																				as lag_agent --> captura o agent da linha anterior considerando a ordem da dt inicio e data fim. Isso para retornar quem aplicou
	from
		dax_share_dax.ent_customer_promotion_psp prom
	left join
		dax_share_dax_mdm.mobi_promotion nam_pro
		on prom.idt_mobi_promotion = nam_pro.idt_mobi_promotion --> nao filtro periodo para pegar todo o historico da linha do tempo das aplicacoes do cliente visto que manipulo as linahs.
	where 
		--//// o cliente precisa estar na base do polo no mes da aplicacao. assim nao pego aplicacoes de periodos onde o cliente nao pertencia ao polo
		exists (
			select 1
			from
				planejamentocomercial_sandbox.planejamentocomercial_work.DDCLI_MES cli
			where prom.idt_safepay_user = cli.idt_safepay_user --> garante que seja retornado apenas a base de clientes do polo
		)
	;



drop table if exists planejamentocomercial_sandbox.planejamentocomercial_work.TPV_GOAL;
create table planejamentocomercial_sandbox.planejamentocomercial_work.TPV_GOAL
diststyle all 
as
	select
		  nam_promotion
		, num_tpv_goal
		, ( num_tpv_goal * 0.30 )																as floor_num_tpv_goal
		, ( num_tpv_goal * 0.15 )																as floor_15_num_tpv_goal
		, dat_update
	from
		dax_share_forca_vendas.promotion_report_outbox
	where 1=1
		and num_tpv_goal is not null
	qualify
		row_number() over( partition by nam_promotion order by dat_update desc ) = 1 --> garante 1 linha para cada linha com sua última atualização quando ativa
		;
	
				

--//// planejamentocomercial_sandbox.planejamentocomercial_work.DFPROMOTION_TREATED RETORNA USUARIO CORRETO DA ATRIBUICAO DO LINK
drop table if exists planejamentocomercial_sandbox.planejamentocomercial_work.DFPROMOTION_TREATED;
create table planejamentocomercial_sandbox.planejamentocomercial_work.DFPROMOTION_TREATED
distkey(idt_safepay_user)
sortkey(idt_safepay_user, month_reference)
as
	select a.*
		, case 
			when a.flg_true = 1 
				and lead( a.flg_true ) over(partition by a.idt_safepay_user 
											order by a.dat_start, a.dat_end) = 2
			then lead( dateadd( day, -1, a.dat_end ) ) over (partition by a.idt_safepay_user --> dateadd adicionado para que no dia da alteração, prevaleça a aplicação que foi alterada. Isso porque no join do processo que captura TPV o TPV viria duplicado para ambas as linhas, repetiria na fim da aplicação inativada e na inicio da nova aplicação
														order by a.dat_start, a.dat_end)
			when 
				lead( a.dat_start ) over(partition by a.idt_safepay_user 
										order by a.dat_start, a.dat_end) = a.dat_end
					and a.dat_start::date <> a.dat_end::date  --> clientes que tiveram mais de uma aplicacao no dia e que a <dat_end> se sobrepoe a data inicio de outro periodo. Criada a regra para evitar duplicidade de TPV pra estes clientes
			then dateadd( day, -1, a.dat_end ) --> dateadd adicionado para que no dia da alteração, prevaleça a aplicação que foi alterada. Isso porque no join do processo que captura TPV o TPV viria duplicado para ambas as linhas, repetiria na fim da aplicação inativada e na inicio da nova aplicação
			else a.dat_end
			end 																					as dat_end_treated
		, goal.floor_num_tpv_goal
		, goal.floor_15_num_tpv_goal
	from(
		select
			  idt_safepay_user
			, month_reference
			, dat_start
			, dat_end
			, dat_load
--			, login
			, idt_mobi_promotion
			, nam_promotion
			, lag_agent
			, case 
				when lag_agent ilike '%\_%' 														then 1 
				else 0
				end 																				as flg_sys --> confere se o log pertence a um usuário de sistema automático																																				 --> aparentemente, usuario de serviço automatico e analistas financeiros tem o underline e criam um log de troca de link com apenas a variação no sufixo
			, case when
				lag( nam_promotion )
					over (partition by idt_safepay_user 
							order by dat_start, dat_end) || 'int' = nam_promotion 					then 1 
				else 0
				end 																				as flg_link_origem --> confere se o link aplicado pelo sistema é o mesmo que o link aplicado pelo executivo
			, ( flg_sys + flg_link_origem )															as flg_true --> diz se ambos os casos que devem ser checados dizem respeito a linha que precisa reapontar o carimbo de <dat_end>
		from
			planejamentocomercial_sandbox.planejamentocomercial_work.DFPROMOTION_RAW prom
--		where idt_safepay_user = 8816 --36158403 -- 108259041 -- 36158403 --3855639
	) a
	left join
		planejamentocomercial_sandbox.planejamentocomercial_work.TPV_GOAL as goal
		using( nam_promotion )
	;



--////>>>>>>>>>>>>>>> ELEGIBILIDADE E RANQUEAMENTOS
drop table if exists planejamentocomercial_sandbox.planejamentocomercial_work.DFELEGIVEL;
create table planejamentocomercial_sandbox.planejamentocomercial_work.DFELEGIVEL
distkey(idt_safepay_user)
sortkey(idt_safepay_user, month_reference, dat_start)
as
with
	ELEGIVEL as (
		select
			  prom.idt_safepay_user
			, prom.month_reference
			, prom.dat_start
			, coalesce( prom.dat_end_treated, current_date )										as dat_end
			, case when prom.dat_end_treated is null then 1 else 0 end								as flg_aplic_ativa
			, prom.dat_load
			, prom.idt_mobi_promotion
			, prom.nam_promotion
			, prom.floor_num_tpv_goal
			, prom.floor_15_num_tpv_goal
			, case
				when idt_mobi_promotion = 1
					and row_number() over( partition by prom.idt_safepay_user order by prom.dat_start, coalesce( prom.dat_end_treated, current_date ) ) = 1 then 1
				else 0
				end																					as flg_default
			, prom.lag_agent
			, last_day( add_months( prom.dat_start::date, 3 ) )										as last_month_reference
		from
			planejamentocomercial_sandbox.planejamentocomercial_work.DFPROMOTION_TREATED prom
		where 1=1
			--//// e o link precisa ter sido aplicado para um cliente do polo naquele mes
			and exists (
				select 1
				from planejamentocomercial_sandbox.planejamentocomercial_work.DDCLI_MES exe
				where exe.idt_safepay_user	= prom.idt_safepay_user
				  and exe.dt_reference		= prom.month_reference
			)
			--//// e o link precisa ter sido aplicado por um executivo do polo naquele mes
			and exists (
				select 1
				from planejamentocomercial_sandbox.planejamentocomercial_work.DDEXEC_MES exe
				where exe.login				= prom.lag_agent
				  and exe.dt_reference		= prom.month_reference
			)
	)
	, RANQUEADO as (
		select
			  e.*
			, row_number() over (partition by e.idt_safepay_user, e.month_reference
								 order by e.dat_start desc, e.dat_end desc)								as ordem_mes_aplic --> 1 para o ultimo link ELEGIVEL do mes por cliente
			, row_number() over (partition by idt_safepay_user, dat_start::date
								 order by dat_start desc, dat_end desc) 								as ordem_dia_aplic --> 1 para o ultimo link ELEGIVEL do dia por cliente
		from
			ELEGIVEL e
		where
			month_reference >= dateadd( month, -13, date_trunc('month', current_date) )  --> últimos 13 meses
	)
	select 
		  *
		, idt_safepay_user::bigint * 100000000 + ( dat_start::date - '1970-01-01'::date )::bigint * 100 + ordem_dia_aplic as chave_aplicacao
	from
		RANQUEADO
	;



--//// FLINKS_UNICOS DIMENSIONA CLIENTES POR MES
--		A APLICACAO DO LINK PRECISA SER DE UM EXECUTIVO POLO E DE UM CLIENTE POLO, MAS NAO
--		NECESSARIAMENTE QUE O CLIENTE SEJA DA CARTEIRA DAQUELE EXECUTIVO
drop table if exists planejamentocomercial_sandbox.planejamentocomercial_work.FLINKS_UNICOS;
create table planejamentocomercial_sandbox.planejamentocomercial_work.FLINKS_UNICOS
distkey(idt_safepay_user)
sortkey(idt_safepay_user, dat_link)
as
	select
		  prom.month_reference																		as dat_link
		, min( prom.month_reference ) over(partition by idt_safepay_user)							as dat_min
		, prom.idt_safepay_user
	from
		planejamentocomercial_sandbox.planejamentocomercial_work.DFELEGIVEL prom
	group by
		  prom.month_reference
		, prom.idt_safepay_user
	;



--//// DDMESES DIMENSIONA OS MESES ANALISADOS
drop table if exists planejamentocomercial_sandbox.planejamentocomercial_work.DDMESES;
create table planejamentocomercial_sandbox.planejamentocomercial_work.DDMESES
diststyle all
sortkey(dat_date)
as
	select
		dat_date
	from
		dax_share_dax_mdm.calendar
	where
		flg_first_day_of_month = 'Y'
		and dat_date  between dateadd( month, -13, date_trunc('month', current_date) ) and date_trunc('month', current_date - 1)
	;



--//// DDGRADE_CLIENTES DIMENSIONA OS MESES POR CLIENTE
drop table if exists planejamentocomercial_sandbox.planejamentocomercial_work.DDGRADE_CLIENTES;
create table planejamentocomercial_sandbox.planejamentocomercial_work.DDGRADE_CLIENTES
distkey(idt_safepay_user)
sortkey(dat_date, idt_safepay_user)
as
	select
		  dat.dat_date
		, link.idt_safepay_user
	from
		planejamentocomercial_sandbox.planejamentocomercial_work.FLINKS_UNICOS link
	cross join
		planejamentocomercial_sandbox.planejamentocomercial_work.DDMESES dat
	where 
		dat.dat_date >= link.dat_min --> garante que retorne todos os meses a partir do primeiro mês de aplicacao do cliente
	group by all
	;



--////>>>>>>>>>>>>>>> DFMARG_DIA - APENAS OS DIAS COM TPV
--//// grao: cliente x dia. so entra dia que teve transacao
drop table if exists planejamentocomercial_sandbox.planejamentocomercial_work.DFMARG_DIA;
create table planejamentocomercial_sandbox.planejamentocomercial_work.DFMARG_DIA
distkey(idt_safepay_user)
sortkey(idt_safepay_user, day_reference)
as
	select
		  marg.dat_contrib_margin::date																as day_reference
		, date_trunc('month', marg.dat_contrib_margin)::date										as month_margin
		, marg.idt_safepay_creditor																	as idt_safepay_user
		, sum(marg.num_tpv_value)																	as num_tpv
		, sum(marg.num_contribution_margin + marg.num_financial_costs)								as num_mo
		, sum(marg.num_contribution_margin)															as num_mc
		, sum(marg.qty_transaction)																	as qty_transaction
		, sum(
				marg.num_gross_intermediation_revenue  + 
				marg.num_gross_installment_revenue +
				marg.num_gross_anticipation_value +
				marg.num_gross_debit_slip +
				marg.num_gross_cred_slip  
			)																						as num_rb
--		, sum(
--				num net intermediation revenue +
--				num net installment revenue +
--				num net cred_slip +
--				num_net debit_slip +
--				num_net_anticipation_value +
--				num_net fee_amount +
--				coalesce(num_net_fee_amount_canc, 0) +
--				num net fee financial institution)
--			) 																						as num_net_take_rote
	from
		dax_share_dax.ent_contribution_margin_kpi_values_psp marg
	where
		marg.dat_contrib_margin >= dateadd( month, -13, date_trunc('month', current_date) )
		and exists (
			select 1
			from
				planejamentocomercial_sandbox.planejamentocomercial_work.DFELEGIVEL e
			where
				e.idt_safepay_user		= marg.idt_safepay_creditor
				and e.ordem_dia_aplic	= 1
				and marg.dat_contrib_margin between e.month_reference and e.last_month_reference --> garante que seja retornado apenas os meses (M0 a M+3) de acordo com periodo do link
		)
	group by all
	;



--////>>>>>>>>>>>>>>> DFMARG_MES - UMA LINHA POR CLIENTE/MES
--//// grao: cliente x mes. a DDGRADE_CLIENTES garante a linha mesmo no mes sem transacao.
drop table if exists planejamentocomercial_sandbox.planejamentocomercial_work.DFMARG_MES;
create table planejamentocomercial_sandbox.planejamentocomercial_work.DFMARG_MES
distkey(idt_safepay_user)
sortkey(idt_safepay_user, month_margin)
as
	select
		  g.dat_date																				as month_margin
		, g.idt_safepay_user
		, coalesce( sum(dia.num_tpv), 0 )															as num_tpv
		, coalesce( sum(dia.num_mo), 0 )															as num_mo
		, coalesce( sum(dia.num_mc), 0 )															as num_mc
		, coalesce( sum(dia.qty_transaction), 0 )													as qty_transaction
		, coalesce( sum(dia.num_rb), 0 )															as num_rb
		, min( case when dia.day_reference is null then 1 else 0 end )								as flg_mes_sem_tpv
	from
		planejamentocomercial_sandbox.planejamentocomercial_work.DDGRADE_CLIENTES g
	left join
		planejamentocomercial_sandbox.planejamentocomercial_work.DFMARG_DIA dia
		on  g.idt_safepay_user	= dia.idt_safepay_user
		and g.dat_date			= dia.month_margin
	where exists (
			select 1
			from
				planejamentocomercial_sandbox.planejamentocomercial_work.DFELEGIVEL e
			where
				e.idt_safepay_user		= g.idt_safepay_user
				and e.ordem_mes_aplic	= 1
				and g.dat_date between e.month_reference and e.last_month_reference
		)
	group by all
	;



drop table if exists planejamentocomercial_sandbox.planejamentocomercial_work.DDDT_MAX;
create table planejamentocomercial_sandbox.planejamentocomercial_work.DDDT_MAX
as
	select
		  max( prom.dat_start )																	as dat_start_max
	from
		planejamentocomercial_sandbox.planejamentocomercial_work.DFELEGIVEL prom
	;



/*>>>>>>>>>>>>>>> DATASET - RESULTADO FINAL (uniao dos tres graos)
 * <tip_grao> separam as visões para o BI
 * 1 --> GRAO DIA VIGENCIA 	- dias em que o link ficou aplicado com o cliente. 
 * 							. contempla apenas para a última aplicacao do dia
 * 							. usada para avaliar performance do link
 * 2 --> GRAO MES SAFRA		- m1 a m3
 * 							. contempla para as linhas do último link aplicado no mês
 * 3 --> GRAO DIA M0		- mes da aplicacao aberto por dia para leitura de MTD
 * 							. e também contempla o registro de todas as aplicacoes do mês
 * 							. a aplicacao substituida fica com kpis 0
 * 
 * <flg_dia> dias em que o link esteve aplicado. <tip_grao> o substitui
 * 
*/
drop table if exists planejamentocomercial_sandbox.planejamentocomercial_work.DATASET;
create table planejamentocomercial_sandbox.planejamentocomercial_work.DATASET
distkey(idt_safepay_user)
sortkey(idt_safepay_user, month_reference)
as
	--//// ---------- 1. GRAO DIA VIGENCIA ----------
	select
		  1																							as tip_grao
		, 1																							as flg_dia
		, prom.dat_start
		, prom.dat_end
		, prom.flg_aplic_ativa
		, prom.month_reference
		, prom.last_month_reference
		, periodo.day_reference
		, periodo.month_margin
		, datediff( month, prom.month_reference, periodo.month_margin)								as num_mes_safra --> 0 = M0, 1 = M1, 2 = M2, 3 = M3
		, 1																							as flg_atribui_tpv
		, 0																							as flg_mes_sem_tpv
		, prom.idt_safepay_user
		, prom.lag_agent
		, prom.idt_mobi_promotion
		, prom.nam_promotion
		, prom.floor_num_tpv_goal
		, prom.floor_15_num_tpv_goal
		, prom.flg_default
		, prom.ordem_dia_aplic
		, prom.ordem_mes_aplic
		, prom.chave_aplicacao
		, extract( day from periodo.day_reference )::integer										as num_dia_mes
		, trunc(sum(periodo.num_tpv), 2)															as num_tpv
		, trunc(sum(periodo.num_mo), 2)																as num_mo
		, trunc(sum(periodo.num_mc), 2)																as num_mc
		, trunc(sum(periodo.num_rb), 2)																as num_rb
		, sum(periodo.qty_transaction)::integer														as qty_transaction
	from
		planejamentocomercial_sandbox.planejamentocomercial_work.DFELEGIVEL prom
	inner join
		planejamentocomercial_sandbox.planejamentocomercial_work.DFMARG_DIA periodo
		on  prom.idt_safepay_user	= periodo.idt_safepay_user
		and prom.ordem_dia_aplic	= 1 --> atribui apenas para as linhas do ultimo link aplicado no dia
		and periodo.day_reference between prom.dat_start::date
									  and least( prom.dat_end::date, prom.last_month_reference ) --> retorna o periodo máximo que os dados deverão ser retornados, sendo que não retorne dias após o M3
	group by all

	union all

	--//// ---------- 2. GRAO MES SAFRA (M1 a M3) ----------
	--//// apenas M1 a M3 consolidado mes
	select
		  2																							as tip_grao
		, 0																							as flg_dia
		, prom.dat_start
		, prom.dat_end
		, prom.flg_aplic_ativa
		, prom.month_reference
		, prom.last_month_reference
		, null::date																				as day_reference
		, mes.month_margin
		, datediff( month, prom.month_reference, mes.month_margin)									as num_mes_safra --> 0 = M0, 1 = M1, 2 = M2, 3 = M3
		, 1																							as flg_atribui_tpv
		, mes.flg_mes_sem_tpv
		, prom.idt_safepay_user
		, prom.lag_agent
		, prom.idt_mobi_promotion
		, prom.nam_promotion
		, prom.floor_num_tpv_goal
		, prom.floor_15_num_tpv_goal
		, prom.flg_default
		, prom.ordem_dia_aplic
		, prom.ordem_mes_aplic
		, prom.chave_aplicacao
		, null::integer																				as num_dia_mes
		, trunc(sum(mes.num_tpv), 2)																as num_tpv
		, trunc(sum(mes.num_mo), 2)																	as num_mo
		, trunc(sum(mes.num_mc), 2)																	as num_mc
		, trunc(sum(mes.num_rb), 2)																	as num_rb
		, sum(mes.qty_transaction)::integer															as qty_transaction
	from
		planejamentocomercial_sandbox.planejamentocomercial_work.DFELEGIVEL prom
	left join
		planejamentocomercial_sandbox.planejamentocomercial_work.DFMARG_MES mes
		on  prom.idt_safepay_user	= mes.idt_safepay_user
--		and prom.ordem_mes_aplic	= 1
		and mes.month_margin between dateadd(month, 1, prom.month_reference) --> garante retornar apenas meses entre M1 e M3. M0 se mantem na branch 3
								 and date_trunc('month', prom.last_month_reference)::date
	where prom.ordem_mes_aplic = 1 
	group by all
	
	union all
--	//// ---------- 3. GRAO DIA M0 + REGISTRO DE APLICAÇÕES ----------
	select
		  3																							as tip_grao
		, 1																							as flg_dia
		, prom.dat_start
		, prom.dat_end
		, prom.flg_aplic_ativa
		, prom.month_reference
		, prom.last_month_reference
		, case 
			when prom.ordem_mes_aplic = 1 then coalesce(dia.day_reference, prom.month_reference) --> cliente sem tpv recebe o dia 1 do mes pra nao sumir da leitura diaria
			end																						as day_reference
		, case 
			when prom.ordem_mes_aplic = 1 then coalesce(dia.month_margin, prom.month_reference)
			end																						as month_margin
		, case when prom.ordem_mes_aplic = 1 then 0 end												as num_mes_safra --> 0 = M0, 1 = M1, 2 = M2, 3 = M3
		, case when prom.ordem_mes_aplic = 1 then 1 else 0 end										as flg_atribui_tpv --> 1 = a aokicacao carrega o tpv do mes
		, case 
			when prom.ordem_mes_aplic = 1 
				and dia.day_reference is null then 1 else 0 
				end																					as flg_mes_sem_tpv --> apenas marca cliente que não transacionou 
		, prom.idt_safepay_user
		, prom.lag_agent
		, prom.idt_mobi_promotion
		, prom.nam_promotion
		, prom.floor_num_tpv_goal
		, prom.floor_15_num_tpv_goal
		, prom.flg_default
		, prom.ordem_dia_aplic
		, prom.ordem_mes_aplic
		, prom.chave_aplicacao
		, case 
			when prom.ordem_mes_aplic = 1 then extract( day from coalesce(dia.day_reference, prom.month_reference) )::integer
			end																						as num_dia_mes
		, trunc(coalesce(sum(dia.num_tpv), 0), 2)													as num_tpv
		, trunc(coalesce(sum(dia.num_mo), 0), 2)													as num_mo
		, trunc(coalesce(sum(dia.num_mc), 0), 2)													as num_mc
		, trunc(coalesce(sum(dia.num_rb), 0), 2)													as num_rb
		, coalesce(sum(dia.qty_transaction), 0)::integer											as qty_transaction
	from
		planejamentocomercial_sandbox.planejamentocomercial_work.DFELEGIVEL prom
	left join
		planejamentocomercial_sandbox.planejamentocomercial_work.DFMARG_DIA dia
		on  prom.idt_safepay_user	= dia.idt_safepay_user
		and dia.month_margin 		= prom.month_reference
		and prom.ordem_mes_aplic = 1
--	where
--		prom.ordem_mes_aplic = 1
	group by all
	;



drop table if exists planejamentocomercial_sandbox.planejamentocomercial_work.DF_FULL_DATASET;
create table planejamentocomercial_sandbox.planejamentocomercial_work.DF_FULL_DATASET
distkey(idt_safepay_user)
sortkey(idt_safepay_user, month_reference)
as
	select 
		  dts.dat_start::date
		, dts.dat_end::date
		, dts.month_reference
		, dts.day_reference
		, dts.month_margin
		, dts.idt_safepay_user
		, dts.idt_mobi_promotion
		, trunc(sum(dts.num_tpv), 2)																as num_tpv
		, trunc(sum(dts.num_mo), 2)																	as num_mo
		, trunc(sum(dts.num_mc), 2)																	as num_mc
		, trunc(sum(dts.num_rb), 2)																	as num_rb
		, sum(qty_transaction)																		as qty_transaction
		, dts.num_mes_safra	--> 0 = M0, 1 = M+1, 2 = M+2, 3 = M+3
		, dts.tip_grao --> 1 = DIA VIGENCIA, 2 = MES M1 A M3, 3 = DIA M0 + REGISTRO APLICACOES
		, dts.floor_num_tpv_goal
		, dts.floor_15_num_tpv_goal
		, dts.flg_default
		, dts.flg_dia
		, dts.flg_aplic_ativa
		, dts.flg_atribui_tpv
		, dts.flg_mes_sem_tpv
		, dts.ordem_dia_aplic
		, dts.ordem_mes_aplic
		, dts.num_dia_mes																			as num_day_reference
--		, tipo_credenciamento																		as tip_credenciamento
		, case 
			when tipo_credenciamento = 'INCREMENTO'													then 1
			when tipo_credenciamento = 'NOVO'														then 2
			when tipo_credenciamento = 'NOVO - 6K' and month_reference < '2026-09-01'				then 2
			when tipo_credenciamento = 'NOVO - 6K' and month_reference >= '2026-09-01'				then 3
			when tipo_credenciamento = 'REATIVAÇÃO'													then 4
			end 																					as tip_credenciamento
		, chave_aplicacao
		, to_char( dts.month_reference, 'dd-mm-yyyy' ) || ' - ' || lag_agent      					as chave_user
	from
		planejamentocomercial_sandbox.planejamentocomercial_work.DATASET dts
	left join 
		planejamentocomercial_sandbox.planejamentocomercial_work.DDCREDENCIAMENTO
		using( idt_safepay_user )
	group by all
--	qualify
--		count(1) over ( partition by idt_safepay_user, month_reference, month_margin, day_reference, idt_mobi_promotion, ordem_dia_aplic, num_tpv, num_mo ) > 1 --order by month_reference, month_margin
--	order by
--		idt_safepay_user, ordem_dia_aplic desc , idt_mobi_promotion desc, dat_start::date, dat_end::date, day_reference
	;




--select
----	count(1)
--	  dat_start
----	, dat_end
--	, month_reference
--	, day_reference
--	, month_margin
--	, idt_safepay_user
--	, idt_mobi_promotion
--	, num_tpv
--	, num_mo
--	, num_mc
--	, num_rb
--	, qty_transaction
--	, num_mes_safra
--	, tip_grao --> 1 = DIA, 2 = MES, 3 = MES M0 diarizado para visão MTD
--	, floor_num_tpv_goal
--	, floor_15_num_tpv_goal
--	, flg_default
----	, flg_dia
----	, flg_aplic_ativa
--	, flg_atribui_tpv
--	, flg_mes_sem_tpv
--	, ordem_dia_aplic
----	, ordem_mes_aplic
----	, num_day_reference
--	, tip_credenciamento
--	, chave_aplicacao
--	, chave_user
--from
--	planejamentocomercial_sandbox.planejamentocomercial_work.DF_FULL_DATASET
----where 1=1
--group by all
----order by
----	idt_safepay_user, ordem_dia_aplic desc , idt_mobi_promotion desc, dat_start, dat_end, day_reference
	


----////>>>>>>>>>>>>>>> DATASET - RESULTADO FINAL VALIDACAO
--	select 
--		  month_reference
--		, month_margin
----		, tip_credenciamento
----		, idt_safepay_user
--		, count(distinct agg.idt_safepay_user) 													as countdist
--		, trunc(sum(agg.num_tpv), 2)															as tpv
--		, trunc(sum(agg.num_mo), 2)																as mo
