/*>>>>>>>>>>>>>>> VALIDACAO v2 x v3 (opcional)
 *
 * 1. Antes de rodar a v3, no mesmo dia, salvar a saida da v2:
 *		create table #DF_FULL_DATASET_V2 as
 *		select * from #DF_FULL_DATASET;
 *
 * 2. Rodar a v3 e a query abaixo. Diferencas esperadas:
 *		. centavos em MO/MC/RB (a v2 truncava por dia, a v3 trunca no total da linha)
 *		. dif_tpv_mtd no tip_grao 2 (a v2 nao tinha MTD no M1 a M3)
 *

with
	V2 as (
		select
			  tip_grao
			, month_reference
			, coalesce( month_margin, '1900-01-01' )												as month_margin
			, sum( num_tpv )																		as tpv
			, sum( num_mo )																			as mo
			, sum( case when num_day_reference <= extract( day from current_date - 1 ) then num_tpv end )	as tpv_mtd
		from
			#DF_FULL_DATASET_V2
		group by 1, 2, 3
	)
	, V3 as (
		select
			  tip_grao
			, month_reference
			, coalesce( month_margin, '1900-01-01' )												as month_margin
			, sum( num_tpv )																		as tpv
			, sum( num_mo )																			as mo
			, sum( case when flg_mtd = 1 then num_tpv end )										as tpv_mtd
		from
			#DF_FULL_DATASET
		group by 1, 2, 3
	)
select
	  coalesce( v3.tip_grao, v2.tip_grao )															as tip_grao
	, coalesce( v3.month_reference, v2.month_reference )											as month_reference
	, coalesce( v3.month_margin, v2.month_margin )													as month_margin
	, coalesce( v3.tpv, 0 ) - coalesce( v2.tpv, 0 )												as dif_tpv
	, coalesce( v3.mo, 0 ) - coalesce( v2.mo, 0 )													as dif_mo
	, coalesce( v3.tpv_mtd, 0 ) - coalesce( v2.tpv_mtd, 0 )										as dif_tpv_mtd
from
	V3 v3
full join
	V2 v2
	on  v2.tip_grao			= v3.tip_grao
	and v2.month_reference	= v3.month_reference
	and v2.month_margin		= v3.month_margin
order by 1, 2, 3
;
*/



